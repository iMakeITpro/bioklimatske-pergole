{"nodes": [{"id": "docs_prd_konfigurator", "label": "PRD: Konfigurator cijene i ispravci podataka", "file_type": "document", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_konfigurator_price_configurator", "label": "Konfigurator cijene (price configurator)", "file_type": "concept", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client spends 2,500-3,000 EUR/month on Google Ads at ~1% conversion because price was never shown; the configurator is the only reason the site exists and everything else serves it."}, {"id": "docs_prd_konfigurator_static_site_constraints", "label": "Technical constraints: static GitHub Pages, no build/npm/external libs, versioned styles.css", "file_type": "rationale", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Site is static with relative paths; shared styles.css carries a version tag bumped on every change (also for any file changed under the same name); verify at 360, 390 and 768 px before commit."}, {"id": "docs_prd_konfigurator_dostavljeno_confidential", "label": "dostavljeno/ folder kept out of repo (.gitignore)", "file_type": "rationale", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client price lists contain margins and must not reach the public repository; cjenik.js therefore carries only final prices."}, {"id": "docs_prd_konfigurator_faza_1", "label": "FAZA 1: Ispravci potvr\u0111enih podataka", "file_type": "concept", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_konfigurator_faza_2", "label": "FAZA 2: Cjenik kao podatkovna datoteka", "file_type": "concept", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_konfigurator_faza_3", "label": "FAZA 3: Konfigurator", "file_type": "concept", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase 3 must not start until Phase 1 is finished and confirmed."}, {"id": "docs_prd_konfigurator_comparison_table_fixes", "label": "Comparison table corrections (wind class 6, rotation 0-120, profile 150x85, 33 colours)", "file_type": "concept", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_konfigurator_sb700_rename", "label": "Rename Tarasola Technic View Pro to Sunbreaker 700", "file_type": "concept", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same product, new name for traceability; file tarasola-technic-view-pro.html becomes sunbreaker-700.html with all links updated."}, {"id": "docs_prd_konfigurator_price_regions", "label": "Three price regions and county-to-region mapping", "file_type": "concept", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_konfigurator_configurator_flow", "label": "Configurator flow (model, dimensions, location, equipment, contact)", "file_type": "concept", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Location is deliberately not the first step; price unlocks only after contact details are given."}, {"id": "docs_prd_konfigurator_discrete_dimensions", "label": "Discrete dimension selection (only table values)", "file_type": "rationale", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The price table is discrete, so the choice must be too: real values only, no arbitrary-step sliders and no interpolation."}, {"id": "docs_prd_konfigurator_rabat_10", "label": "10% configurator discount shown as separate line item", "file_type": "rationale", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discount is a real condition of inquiries arriving via the configurator, not an invented anchor, so it is shown as its own line instead of a struck-through price; does not apply to transport/assembly."}, {"id": "docs_prd_konfigurator_vat_toggle", "label": "VAT toggle Fizi\u010dka osoba / Pravna osoba", "file_type": "rationale", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consumers must be shown prices including VAT by law (default: private); business buyers see net amount with VAT separate."}, {"id": "docs_prd_konfigurator_out_of_range", "label": "Out-of-range dimension shows contact CTA, not a price", "file_type": "rationale", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wider builds need a middle column which changes the structure and is not in the price list; guarded in depth (unselected county, missing price cell)."}, {"id": "docs_prd_konfigurator_equipment_pricing", "label": "Equipment pricing: LED 1200, rain sensor 500, wind sensor 400; rest 'na upit'", "file_type": "concept", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unpriced items (ZIP screens, sliding glass walls, IR heaters, slide grilles, brise-soleil, non-standard RAL) stay on inquiry because price would rise sharply; communicated by phone."}, {"id": "docs_prd_konfigurator_email_payload", "label": "Inquiry email via Web3Forms with county, region, on-inquiry items, discount, customer type", "file_type": "concept", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_konfigurator_stays_on_landing", "label": "Decision: configurator stays on index.html landing", "file_type": "rationale", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client decision 8.9.2026: configurator is the main function of the site and must not leave the landing page; the original proposal of a separate page for Google Ads Quality Score was consciously rejected."}, {"id": "docs_prd_konfigurator_client_answers", "label": "Client answers blocking Phase 3 (Josip, 8.9.2026)", "file_type": "concept", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_konfigurator_ux_fixes", "label": "Four UX fixes after first client test", "file_type": "concept", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_konfigurator_price_invalidation", "label": "Config change after unlock invalidates quote and requires new inquiry", "file_type": "rationale", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Price must not silently update after unlock; any configuration change resets to the form with a notice. VAT toggle is exempt because it is a view of the same quote."}, {"id": "docs_prd_konfigurator_ads_event", "label": "konfigurator:upit-poslan custom event (ads tracking hook)", "file_type": "concept", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ads tracking is done by the client separately later; the event exists only as a reference hook and is not a task."}, {"id": "docs_prd_konfigurator_tip_kupca_bug", "label": "Tip kupca toggle bug and fix (moved into #cfgForm; resolved)", "file_type": "concept", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_konfigurator_projekti_rename", "label": "187 realizacija renamed to Projekti with real project photos (resolved)", "file_type": "concept", "source_file": "docs/PRD-konfigurator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_prd_konfigurator", "target": "docs_prd_konfigurator_price_configurator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PRD-konfigurator.md", "source_location": "\u00a71", "weight": 1.0}, {"source": "docs_prd_konfigurator", "target": "docs_prd_konfigurator_static_site_constraints", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PRD-konfigurator.md", "source_location": "\u00a72", "weight": 1.0}, {"source": "docs_prd_konfigurator", "target": "docs_prd_konfigurator_faza_1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PRD-konfigurator.md", "source_location": "FAZA 1", "weight": 1.0}, {"source": "docs_prd_konfigurator", "target": "docs_prd_konfigur