{"nodes": [{"id": "index", "label": "Naslovnica (index.html)", "file_type": "document", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_tt_gradnja", "label": "TT Gradnja d.o.o. (Slavonski Brod)", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_selt_by_aluprof", "label": "SELT by Aluprof - proizvo\u0111a\u010d, TT Gradnja ovla\u0161teni zastupnik za RH od 2018.", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_hero_video", "label": "Hero sekcija i video naslovnice (Terasa koju koristite 365 dana u godini)", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Poster loads first, video fetched after first paint for speed; desktop and mobile (portrait) sources with AV1/HEVC/H.264 fallbacks; text+CTA grouped as one block per Josip's recommendation"}, {"id": "index_hero_claims_strip", "label": "Traka prednosti: 2-4 tjedna isporuka, 10 god. jamstva, +200 km/h, 33 boje", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_three_tier_offer", "label": "Tri razine premium ponude (kartice SB400, SB500, SB700)", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_configurator", "label": "Konfigurator okvirne ponude (Model, Dimenzije, Lokacija, Oprema, Cijena)", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Price comes exclusively from the real production price list (cjenik.js), never from invented formulas; inquiry unlocks the price after contact details; 10% configurator discount shown as a separate line item, never a struck-through price"}, {"id": "index_configurator_equipment", "label": "Oprema u konfiguratoru: LED +1.200 EUR, senzor ki\u0161e +500 EUR, senzor vjetra +400 EUR; ostalo na upit", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_customer_type_toggle", "label": "Tip kupca: Fizi\u010dka osoba (cijena s PDV-om) / Pravna osoba (bez PDV-a)", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Private buyers must see VAT-inclusive price (legal obligation); business buyers see net price; moved into the form before submit so the choice changes the main total and reaches the e-mail payload"}, {"id": "index_location_transport", "label": "Lokacija (\u017eupanija) -> regija -> transport i monta\u017ea iz Slavonskog Broda", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_model_comparison_table", "label": "Usporedba modela SB400 / SB500 / SB700 (tablica specifikacija)", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_wind_resistance_class_6", "label": "Otpornost na vjetar klasa 6 (EN 13561, 400 Pa = 40,8 kg/m2)", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_projects_gallery", "label": "Galerija Projekti (40 realizacija, postupno prikazivanje 6-18-sve)", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All 40 real projects imported from the old site bioklimatskepergole.hr; images are hotlinked (risk if old site goes down); model name removed from card captions, only location shown"}, {"id": "index_gallery_lightbox", "label": "Lightbox galerije (strelice, Escape, klik izvan, href fallback bez JS-a)", "file_type": "rationale", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lightbox reads the full URL from the card href, not img.src, because the image-fallback handler clears img.src on failed thumbnails; sticky header and mobile CTA bar are hidden while it is open to avoid icon collisions"}, {"id": "index_process_steps", "label": "Proces suradnje u 5 koraka (upit 24h, izlazak i 3D, fiksna ponuda 30 dana, proizvodnja 2-4 tjedna, monta\u017ea 1-2 dana)", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_process_video_carousel", "label": "Karusel monta\u017enih videa (3 YouTube videa, click-to-load, centar uve\u0107an)", "file_type": "rationale", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Click-to-load video-facade avoids loading YouTube iframes with the page; side videos are peek-only and re-center on click; height fixed in px to stop vertical jump during transitions"}, {"id": "index_guarantee_section", "label": "Jamstvo i sigurnost kupnje (10 god. konstrukcija, 5 god. motori, 2 god. elektronika, 0 EUR razlike, servis 72 h)", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placed before reviews so buyers first get reasons the investment is safe and only then third-party words as confirmation"}, {"id": "index_trust_claims", "label": "Jo\u0161 razloga za povjerenje (izravno iz tvornice, EU standardi, 40+ god., izgled nepromijenjen, kompletan proizvod u jednoj kompaniji)", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_aluprof_group_stats", "label": "Aluprof grupacija: 70+ god., 590 mil. EUR prihoda, 61 zemlja, 2.600 partnera", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_reviews_carousel", "label": "Karusel Google recenzija (3 vidljive, ru\u010dno listanje strelicama, podaci iz recenzije.js)", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual left/right arrows replaced auto-slide; clones on both ends for seamless loop; click locked during transition so rapid clicks cannot push the index outside the clone range"}, {"id": "index_google_rating", "label": "Google ocjena 4,8/5 (31 recenzija, snimka od 10.9.2026.)", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_faq", "label": "\u010cesta pitanja (7 prodajnih pitanja: cijena, razlika u cijeni, dozvola, servis, u\u017eivo, odr\u017eavanje)", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_json_ld", "label": "Strukturirani podaci JSON-LD (LocalBusiness, Product SB500, FAQPage)", "file_type": "concept", "source_file": "index.html", "source_location":